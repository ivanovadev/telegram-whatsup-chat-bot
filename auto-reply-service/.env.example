# ============================================
# Telegram API Credentials
# ============================================
# Get from https://my.telegram.org/apps
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Session file path (relative to service directory)
TG_SESSION_PATH=./data/session.session

# ============================================
# Control Chat
# ============================================
# Control chat ID (use "me" for Saved Messages)
CONTROL_CHAT_ID=me

# ============================================
# Busy Mode
# ============================================
# Enable/disable busy mode
# Options: on, off
BUSY_MODE=on

# ============================================
# Whitelist
# ============================================
# Enable/disable whitelist
# Options: on, off
WHITELIST_ENABLED=on

# Husband username (single username, without @)
# Example: eugen_parasochka_pl
HUSBAND_USERNAME=

# Friends usernames (comma-separated, without @)
# Example: user1,user2,user3
FRIENDS_USERNAMES=

# ============================================
# Cooldown
# ============================================
# Cooldown between cards per user (seconds)
COOLDOWN_SEC=300

# ============================================
# Context
# ============================================
# Number of previous messages to include in context
CONTEXT_MESSAGES=3

# ============================================
# LLM Settings
# ============================================
# Enable/disable LLM
# Options: on, off
LLM_ENABLED=off

# OpenAI API Key
OPENAI_API_KEY=

# OpenAI Model
OPENAI_MODEL=gpt-5.2

# Maximum output tokens
MAX_OUTPUT_TOKENS=150

# ============================================
# Budget Control
# ============================================
# Daily budget limit (USD)
DAILY_BUDGET_USD=2.0

# Alert threshold (USD)
ALERT_AT_USD=1.5

# Hard stop threshold (USD)
HARD_STOP_USD=2.5
