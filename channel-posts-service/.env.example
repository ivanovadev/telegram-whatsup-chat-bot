# ============================================
# Telegram API Credentials
# ============================================
# Get from https://my.telegram.org/apps
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Session file path (relative to service directory)
TG_SESSION_PATH=./data/session.session

# ============================================
# Channel Posts (Production)
# ============================================
# Enable/disable automated channel posts (for production)
# Options: on, off
CHANNEL_POSTS_ENABLED=off

# Channel ID
# Example: -1001234567890
# Get ID by forwarding a message from the channel and using "get group id" command
CHANNEL_ID=

# Channel username (alternative to CHANNEL_ID)
# Example: travel_channel (without @)
CHANNEL_USERNAME=

# Morning post time (24-hour format)
MORNING_POST_TIME=09:00

# Evening post time (24-hour format)
EVENING_POST_TIME=20:00

# ============================================
# LLM Settings
# ============================================
# Enable/disable LLM
# Options: on, off
LLM_ENABLED=off

# OpenAI API Key
OPENAI_API_KEY=

# OpenAI Model
OPENAI_MODEL=gpt-5.2

# Maximum output tokens
MAX_OUTPUT_TOKENS=1000

# ============================================
# Image Service
# ============================================
# Unsplash Access Key
# Get from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
