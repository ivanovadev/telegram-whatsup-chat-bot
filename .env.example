# Telegram API credentials
# Get from https://my.telegram.org/apps
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here
TG_SESSION_PATH=./data/session.session

# Control chat
# For Saved Messages you can use "me"
CONTROL_CHAT_ID=me

# Modes
BUSY_MODE=on
WHITELIST_ENABLED=off

# Limits
COOLDOWN_SEC=300
CONTEXT_MESSAGES=10
MAX_OUTPUT_TOKENS=200

# Cost guard (USD)
DAILY_BUDGET_USD=2.0
ALERT_AT_USD=1.5
HARD_STOP_USD=2.5

# LLM (optional)
LLM_ENABLED=off
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
