# ============================================
# Telegram Userbot - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# REQUIRED: Telegram API Credentials
# ============================================
# Get these from https://my.telegram.org/apps
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Optional: Custom session path (default: ./data/session.session)
TG_SESSION_PATH=./data/session.session

# ============================================
# Control Chat Configuration
# ============================================
# Where cards and notifications appear
# "me" = Saved Messages (default)
# Or use chat ID: -1001234567890
CONTROL_CHAT_ID=me

# ============================================
# Bot Modes
# ============================================
# Enable/disable busy mode (auto-create cards for incoming messages)
# Options: on, off
BUSY_MODE=on

# Enable/disable whitelist mode
# If enabled, only whitelisted users' messages will be processed
# Options: on, off
WHITELIST_ENABLED=on

# Whitelist usernames (comma-separated, without @)
# Example: username1,username2,eugen_parasochka_pl
WHITELIST_USERNAMES=

# Cooldown between cards for the same user (in seconds)
# Default: 300 (5 minutes)
COOLDOWN_SEC=300

# Number of recent messages to use as context for LLM
# Default: 10
CONTEXT_MESSAGES=10

# ============================================
# LLM Configuration (OpenAI)
# ============================================
# Enable/disable LLM features
# Options: on, off
LLM_ENABLED=off

# OpenAI API Key
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model to use
# Recommended: gpt-4o-mini (cheaper) or gpt-4o (better quality)
OPENAI_MODEL=gpt-4o-mini

# Maximum output tokens for LLM responses
# Default: 200 for suggester, 500 for channel content
MAX_OUTPUT_TOKENS=200

# ============================================
# Budget Control
# ============================================
# Daily budget limit in USD
# Default: 2.0
DAILY_BUDGET_USD=2.0

# Alert threshold in USD (bot will notify when reached)
# Default: 1.5
ALERT_AT_USD=1.5

# Hard stop threshold in USD (bot will stop using LLM when reached)
# Default: 2.5
HARD_STOP_USD=2.5

# ============================================
# Group/Channel Posts (Travel Posts)
# ============================================
# Enable/disable automated group/channel posts
# Options: on, off
CHANNEL_POSTS_ENABLED=off

# Group/Channel ID (use negative number for groups)
# Example: -1001234567890
# Get ID by forwarding a message from the group and using "get group id" command
CHANNEL_ID=

# Group/Channel username (alternative to CHANNEL_ID)
# Example: Travel (without @)
CHANNEL_USERNAME=

# Morning post time (24-hour format)
# Default: 09:00
MORNING_POST_TIME=09:00

# Evening post time (24-hour format)
# Default: 20:00
EVENING_POST_TIME=20:00

# ============================================
# Image Service (Unsplash)
# ============================================
# Unsplash API Access Key for fetching country images
# Get from https://unsplash.com/developers
# Optional: Leave empty if you don't want images in posts
UNSPLASH_ACCESS_KEY=

# ============================================
# Notes
# ============================================
# - All paths are relative to the project root
# - Time formats: Use 24-hour format (HH:MM)
# - Boolean values: Use "on" or "off" (case-insensitive)
# - Leave optional values empty if not needed
# - Never commit .env file to git (it's in .gitignore)
